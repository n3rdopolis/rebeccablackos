#This utility works the same as chvt, only it uses logind's seat aware SwitchTo dbus method

function GetvTTYSeat
{
  #Get the leading PID of the session
  SessionLeaderPIDData=($(busctl call org.freedesktop.login1 /org/freedesktop/login1/session/self org.freedesktop.DBus.Properties Get "ss" org.freedesktop.login1.Session Leader))
  SessionLeaderPID=${SessionLeaderPIDData[2]}

  #Get the PID that started the session
  SessionLeaderProcData=($(cat /proc/$SessionLeaderPID/stat))
  SessionCallerPID=${SessionLeaderProcData[3]}

  #Get the service that the calling PID is in
  SessionServicePathData=($(busctl call org.freedesktop.systemd1 /org/freedesktop/systemd1 org.freedesktop.systemd1.Manager GetUnitByPID "u" $SessionCallerPID))
  SessionServicePath=${SessionServicePathData[1]}
  SessionServicePath=${SessionServicePath//\"/}

  #Get the leading PID of the service
  SessionServiceMainPIDData=($(busctl call org.freedesktop.systemd1 $SessionServicePath org.freedesktop.DBus.Properties Get "ss" org.freedesktop.systemd1.Service MainPID))
  SessionServiceMainPID=${SessionServiceMainPIDData[2]}

  #Get the path of the program that is the leading PID, the first argument (Should be the vTTY instance), and the user it is running as
  readarray -d $'\0' SessionServiceMainPIDProcCmdline < /proc/$SessionServiceMainPID/cmdline
  SessionServiceMainPIDProgram=${SessionServiceMainPIDProcCmdline[1]}
  vTTYInstance=${SessionServiceMainPIDProcCmdline[2]}
  vTTYSeat=$(echo $vTTYInstance | awk -F '@' '{print $1}')
  echo $vTTYSeat
}

function ChvtLogindMain
{
  SessionNumber=$1
  SwitchSeat=$2

  if [[ -z $SessionNumber ]]
  then
    ExecutableName=$(basename $0)
    echo "This utility switches to a session number that is running on the current seat, or specified seat"
    echo " If there are VTs on the seat the session number is the vt number"
    echo " If there are no VTs on the seat the session number is relative to the start order of sessions on the seat"
    echo ""
    echo "$ExecutableName: Not enough arguments."
    echo "usage: $ExecutableName <session number>"
    echo "or"
    echo "usage: $ExecutableName <relative session number> <seat id>"
    exit 1
  fi

  if [[ -z $SwitchSeat ]]
  then
    #If no seat was specified as the second argument
    SeatPath=""

    if [[ ! -z $XDG_SEAT && $XDG_SEAT != seat-vtty ]]
    then
      SeatData=($(busctl call org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager GetSeat "s" $XDG_SEAT))
      SeatPath=${SeatData[1]//\"/}
    else
      vTTYSeat=$(GetvTTYSeat)
      SeatData=($(busctl call org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager GetSeat "s" $vTTYSeat))
      SeatPath=${SeatData[1]//\"/}
    fi

    #If the seat cannot be determined, assume seat0
    if [[ $SeatPath != "" ]]
    then
      busctl call org.freedesktop.login1 $SeatPath org.freedesktop.login1.Seat SwitchTo u $SessionNumber
    else
      busctl call org.freedesktop.login1 /org/freedesktop/login1/seat/seat0 org.freedesktop.login1.Seat SwitchTo u $SessionNumber
    fi
  else
    SeatData=($(busctl call org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager GetSeat "s" $SwitchSeat))
    Result=$?
    SeatPath=${SeatData[1]//\"/}

    if [[ $Result == 0 ]]
    then
      busctl call org.freedesktop.login1 $SeatPath org.freedesktop.login1.Seat SwitchTo u $SessionNumber
    else
      echo "Seat $SwitchSeat doesn't exist"
      exit 1
    fi
  fi
  exit
}
ChvtLogindMain "$@"
